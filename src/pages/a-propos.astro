    <header class="page-head"><span class="eyebrow">À propos</span><h1>Jean-Yves Caillot</h1></header>
    <div class="about-grid">
      <aside>
        <div class="ph" style="--r:1"><img src="/img/extra/about-2.webp" width="1200" height="1651" alt="Portrait samburu, photographie de Jean-Yves Caillot" loading="eager" draggable="false" /><button type="button" tabindex="-1" aria-hidden="true" style="cursor:default"></button></div>
